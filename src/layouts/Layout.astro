---
interface Props {
	title?: string;
}
const { title = 'Nexo Consultora Ambiental' } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="Nexo Consultora Ambiental ofrece asesoría, trámites, estudios y capacitación ambiental para empresas, entes públicos y privados. Desarrollo sustentable en La Pampa y Argentina." />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content="Consultora ambiental interdisciplinaria: asesoramiento legal, trámites, estudios y capacitación para un desarrollo sustentable." />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://nexo-consultora-ambiental.vercel.app" />
		<meta property="og:image" content="https://nexo-consultora-ambiental.vercel.app/images/nexo-logo-color.png" />
		<link rel="icon" href="/images/favicon.ico" type="image/x-icon" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Poppins:wght@700&display=swap" rel="stylesheet" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
