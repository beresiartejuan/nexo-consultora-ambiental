<nav class="navbar">
    <svg
        class="menu-icon"
        fill="#ffffff"
        width="32px"
        height="32px"
        viewBox="0 0 512 512"
        xmlns="http://www.w3.org/2000/svg"
        ><title>menu</title><path
            d="M64 96L448 96 448 144 64 144 64 96ZM64 232L448 232 448 280 64 280 64 232ZM64 368L448 368 448 416 64 416 64 368Z"
        ></path></svg
    >
    <div class="nav-links">
        <a href="#inicio">Inicio</a>
        <a href="#nosotros">Sobre nosotros</a>
        <a href="#servicios">Nuestros servicios</a>
        <a href="#proyectos">Nuestros proyectos</a>
        <a href="#equipo">Nuestro equipo</a>
        <a href="#blog">Blog</a>
        <a href="#contacto">Contáctanos</a>
    </div>
</nav>

<style>
    .navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        max-width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: #008549;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.2);
        z-index: 1000;
    }

    .menu-icon {
        display: none;
        cursor: pointer;
        margin: 15px;
    }

    .nav-links {
        display: flex;
        flex-direction: row;
    }

    .navbar a {
        font-family: "Poppins", sans-serif;
        color: rgb(253, 244, 244);
        text-decoration: none;
        font-size: 18px;
        font-weight: bold;
        transition: all 500ms;
        padding: 20px;
    }

    .navbar a:hover {
        background-color: rgb(0, 110, 61);
    }

    @media (max-width: 1140px) {
        .menu-icon {
            display: block;
        }

        .nav-links {
            display: none;
            min-width: 100%;
            flex-direction: column;
            align-items: center;
        }

        .nav-links.active {
            display: flex;
        }

        .navbar {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<script>
    const menuIcon = document.querySelector(".menu-icon") as HTMLElement;
    const navLinks = document.querySelector(".nav-links") as HTMLElement;

    menuIcon.addEventListener("click", () => {
        navLinks.classList.toggle("active");
    });
</script>
