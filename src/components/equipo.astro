---
const equipo = [
    {
        nombre: "Marcela Pérez",
        imagen: "/assets/Avatar1.png",
        linkedin: "#",
        descripcion:
            "Ingeniera en Recursos Naturales y Medio Ambiente, experta en cálculo de huella de carbono.",
    },
    {
        nombre: "Carla López",
        imagen: "/assets/Avatar2.png",
        linkedin: "#",
        descripcion:
            "Ingeniera en Recursos Naturales y Medio Ambiente, experta en auditorías ambientales.",
    },
    {
        nombre: "Andrea Gómez",
        imagen: "/assets/Avatar3.png",
        linkedin: "#",
        descripcion:
            "Progect Manager, experta en planificación, organización y supervición de proyectos.",
    },
];
---

<style>
    .equipo-container {
        background-color: #d3d3d3;
        display: flex;
        flex-direction: column;
        gap: 40px;
        max-width: 800px;
        margin: 20px auto;
    }

    .miembro {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 10px;
    }

    .miembro:nth-child(odd) {
        flex-direction: row-reverse; /* Alternar imagen a la derecha */
    }

    .descripcion {
        max-width: 58%;
        font-size: 14px;
        color: #2e7d32;
    }

    .perfil {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #ddd;
        transition: opacity 0.3s ease-in-out;
    }

    .perfil:hover {
        opacity: 0; /* Oculta la imagen en hover */
    }

    .perfil-container {
        position: relative;
        width: 120px;
        height: 140px;
    }

    .perfil-linkedin {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url("/assets/linkedin-brands.svg"); /* Ícono de LinkedIn */
        background-size: cover;
        background-position: center;
        border-radius: 50%;
        opacity: 0; /* Oculto por defecto */
        transition: opacity 0.3s ease-in-out;
    }

    .perfil-container:hover .perfil-linkedin {
        opacity: 1; /* Muestra LinkedIn en hover */
    }

    p {
        font-size: 20px;
        color: #5a5a5a;
    }
</style>

<div class="equipo-container">
    {
        equipo.map((persona) => (
            <div class="miembro">
                <div class="perfil-container">
                    <a href={persona.linkedin} target="_blank">
                        <img
                            class="perfil"
                            src={persona.imagen}
                            alt={persona.nombre}
                        />
                        <div class="perfil-linkedin" />
                    </a>
                </div>
                <div class="descripcion">
                    <p>
                        <strong>{persona.nombre}</strong>
                    </p>
                    <h2 class="subtitulo">{persona.descripcion}</h2>
                </div>
            </div>
        ))
    }
</div>
