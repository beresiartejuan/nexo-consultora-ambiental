---
const equipo = [
  { nombre: "Melany Figueroa Blanco", imagen: "src/styles/images/Melany Figueroa - Nexo consultora.jpeg", linkedin: "https://www.linkedin.com/in/melany-figueroa-blanco/recent-activity/all/", descripcion: "Ingeniera en Recursos Naturales y Medio Ambiente. Diplomada en Gestión Ambiental. Experiencia en calidad. Interés en sostenibilidad y consultoría ambiental." },
  { nombre: "Irina Rivero", imagen: "/src/styles/images/Irina Rivero - Nexo consultora.jpeg", linkedin: "https://www.linkedin.com/in/irina-no%C3%A9-rivero-7126a9175/", descripcion: "Ing. en Recursos Naturales y Medio Ambiente, Técnica Superior en Seguridad e Higiene Laboral Cargos como Jefa de Planta en la industria del Biogás y Funcionaria en el área de espacios verdes" },
  { nombre: "Laura Ambrosio", imagen: "src/styles/images/Laura Ambrosio - Nexo consultora.jpeg", linkedin: "https://www.linkedin.com/in/laura-ambrosio-209156325/", descripcion: "Ingeniera en Recursos Naturales y Medio Ambiente, actualmente cursando una Diplomatura Superior Universitaria en Gestión Ambiental de Sistemas" },
  { nombre: "Daiana Rivas", imagen: "src/styles/images/Daiana Rivas - Nexo consultora.jpeg", linkedin: "https://www.linkedin.com/in/daiana-rivas-74b766232/?utm_source=share&utm_campaign=share_via&utm_content=profile&utm_medium=android_app", descripcion: "Ingeniera en Recursos Naturales y Medio Ambiente. Cargos cómo Analista de Medio Ambiente y Resonsable Técnica Ambiental." },
];
---


<style>
.equipo-container {
  background-color: #D3D3D3;
  display: flex;
  flex-direction: column;
  gap: 40px;
  max-width: 800px;
  margin: 0 auto;
  
}

.miembro {
  display: flex;
  align-items: center;
  gap: 20px;
}

.miembro:nth-child(odd) {
  flex-direction: row-reverse; /* Alternar imagen a la derecha */
}

.descripcion {
  max-width: 58%;
  font-size: 14px;
  color: #2E7D32

}

.perfil {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  object-fit: cover;
  border: 3px solid #ddd;
  transition: opacity 0.3s ease-in-out;
}

.perfil:hover {
  opacity: 0; /* Oculta la imagen en hover */
}

.perfil-container {
  position: relative;
  width: 120px;
  height: 140px;
}

.perfil-linkedin {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: url('../src/assets/linkedin-brands.svg'); /* Ícono de LinkedIn */
  background-size: cover;
  background-position: center;
  border-radius: 50%;
  opacity: 0; /* Oculto por defecto */
  transition: opacity 0.3s ease-in-out;
}

.perfil-container:hover .perfil-linkedin {
  opacity: 1; /* Muestra LinkedIn en hover */
}

p {
  font-size: 20px;
  color: #5A5A5A;
}

</style>

<div class="equipo-container">
  {equipo.map((persona) => (
    <div class="miembro">
      <div class="perfil-container">
        <a href={persona.linkedin} target="_blank">
          <img class="perfil" src={persona.imagen} alt={persona.nombre} />
          <div class="perfil-linkedin"></div>
        </a>
      </div>
      <div class="descripcion">
        <p><strong>{persona.nombre}</p></strong>
        <h2 class="subtitulo">{persona.descripcion}</h2>
      </div>
    </div>
  ))}
</div>
