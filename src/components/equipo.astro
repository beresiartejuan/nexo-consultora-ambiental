
---
const equipo = [
  { nombre: "Melany Figueroa Blanco", imagen: "/images/Melany Figueroa - Nexo consultora.jpeg", linkedin: "https://www.linkedin.com/in/melany-figueroa-blanco/", descripcion: "Ingeniera en Recursos Naturales y Medio Ambiente. Diplomada en Gestión Ambiental. Experiencia en calidad. Interés en sostenibilidad y consultoría ambiental." },
  { nombre: "Irina Rivero", imagen: "/images/Irina Rivero - Nexo consultora.jpeg", linkedin: "https://www.linkedin.com/in/irina-no%C3%A9-rivero-7126a9175/", descripcion: "Ing. en Recursos Naturales y Medio Ambiente, Técnica Superior en Seguridad e Higiene Laboral. Cargos como Jefa de Planta en la industria del Biogás y Funcionaria en el área de espacios verdes." },
  { nombre: "Laura Ambrosio", imagen: "/images/Laura Ambrosio - Nexo consultora.jpeg", linkedin: "https://www.linkedin.com/in/laura-ambrosio-209156325/", descripcion: "Ingeniera en Recursos Naturales y Medio Ambiente, actualmente cursando una Diplomatura Superior Universitaria en Gestión Ambiental de Sistemas." },
  { nombre: "Daiana Rivas", imagen: "/images/Daiana Rivas - Nexo consultora.jpeg", linkedin: "https://www.linkedin.com/in/daiana-rivas-74b766232/?utm_source=share&utm_campaign=share_via&utm_content=profile&utm_medium=android_app", descripcion: "Ingeniera en Recursos Naturales y Medio Ambiente. Cargos como Analista de Medio Ambiente y Responsable Técnica Ambiental." },
];
---

<div class="equipo-grid">
  {equipo.map((persona) => (
    <article class="miembro-card">
      <div class="perfil-container">
        <a class="perfil-link" href={persona.linkedin} target="_blank" aria-label={`LinkedIn de ${persona.nombre}`}>
          <img class="perfil" src={persona.imagen} alt={persona.nombre} loading="lazy" width="160" height="160" />
          <svg class="linkedin-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M19 0h-14c-2.76 0-5 2.24-5 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5v-14c0-2.76-2.24-5-5-5zm-11 19h-3v-10h3v10zm-1.5-11.5c-1 0-1.5-.7-1.5-1.5s.5-1.5 1.5-1.5 1.5.7 1.5 1.5-.5 1.5-1.5 1.5zm13.5 11.5h-3v-5.5c0-1.5-.5-2.5-1.8-2.5-1 0-1.6.7-1.9 1.4-.1.3-.1.7-.1 1.1v5.5h-3v-10h2.9v1.4c.4-.7 1.3-1.7 3.2-1.7 2.3 0 4.1 1.5 4.1 4.7v5.6z"/>
          </svg>
        </a>
      </div>
      <div class="miembro-info">
        <h3 class="nombre">{persona.nombre}</h3>
        <p class="descripcion">{persona.descripcion}</p>
      </div>
    </article>
  ))}
</div>

<style>
.equipo-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(260px, 1fr));
  gap: 2rem;
  max-width: 900px;
  margin: 2.5rem auto 0;
}

.miembro-card {
  background-color: var(--color-blanco);
  border-radius: var(--radio);
  padding: 2rem 1.5rem;
  text-align: center;
  box-shadow: var(--sombra);
  transition: transform var(--transicion), box-shadow var(--transicion);
}

.miembro-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--sombra-hover);
}

.perfil-container {
  position: relative;
  width: 160px;
  height: 160px;
  margin: 0 auto 1.25rem;
}

.perfil-link {
  display: block;
  width: 160px;
  height: 160px;
  border-radius: 50%;
  position: relative;
  overflow: hidden;
  box-shadow: 0 0 0 4px var(--color-verde-claro);
  transition: box-shadow var(--transicion);
}

.perfil-link:hover,
.perfil-link:focus-visible {
  box-shadow: 0 0 0 4px var(--color-verde);
}

.perfil {
  width: 160px;
  height: 160px;
  border-radius: 50%;
  object-fit: cover;
  display: block;
}

.linkedin-icon {
  position: absolute;
  inset: 0;
  width: 40px;
  height: 40px;
  margin: auto;
  fill: var(--color-blanco);
  opacity: 0;
  transition: opacity 0.3s ease-in-out;
  pointer-events: none;
  z-index: 2;
}

.perfil-link::before {
  content: "";
  position: absolute;
  inset: 0;
  background-color: rgba(46, 125, 50, 0.85);
  border-radius: 50%;
  opacity: 0;
  transition: opacity 0.3s ease-in-out;
  z-index: 1;
}

.perfil-link:hover::before,
.perfil-link:focus-visible::before,
.perfil-link:hover .linkedin-icon,
.perfil-link:focus-visible .linkedin-icon {
  opacity: 1;
}

.miembro-info {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.nombre {
  font-family: 'Poppins', sans-serif;
  font-size: 1.15rem;
  color: var(--color-verde);
  margin: 0;
}

.descripcion {
  font-size: 0.95rem;
  color: var(--color-gris-medio);
  line-height: 1.6;
  margin: 0;
}

@media (max-width: 768px) {
  .equipo-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .perfil-container,
  .perfil-link,
  .perfil {
    width: 140px;
    height: 140px;
  }
}
</style>
