
---
const equipo = [
  { nombre: "Melany Figueroa Blanco", imagen: "/images/Melany Figueroa - Nexo consultora.jpeg", linkedin: "https://www.linkedin.com/in/melany-figueroa-blanco/", descripcion: "Ingeniera en Recursos Naturales y Medio Ambiente. Diplomada en Gestión Ambiental. Experiencia en calidad. Interés en sostenibilidad y consultoría ambiental." },
  { nombre: "Irina Rivero", imagen: "/images/Irina Rivero - Nexo consultora.jpeg", linkedin: "https://www.linkedin.com/in/irina-no%C3%A9-rivero-7126a9175/", descripcion: "Ing. en Recursos Naturales y Medio Ambiente, Técnica Superior en Seguridad e Higiene Laboral Cargos como Jefa de Planta en la industria del Biogás y Funcionaria en el área de espacios verdes" },
  { nombre: "Laura Ambrosio", imagen: "/images/Laura Ambrosio - Nexo consultora.jpeg", linkedin: "https://www.linkedin.com/in/laura-ambrosio-209156325/", descripcion: "Ingeniera en Recursos Naturales y Medio Ambiente, actualmente cursando una Diplomatura Superior Universitaria en Gestión Ambiental de Sistemas" },
  { nombre: "Daiana Rivas", imagen: "/images/Daiana Rivas - Nexo consultora.jpeg", linkedin: "https://www.linkedin.com/in/daiana-rivas-74b766232/?utm_source=share&utm_campaign=share_via&utm_content=profile&utm_medium=android_app", descripcion: "Ingeniera en Recursos Naturales y Medio Ambiente. Cargos cómo Analista de Medio Ambiente y Resonsable Técnica Ambiental." },
];
---


<style>
.equipo-container {
  background-color: #D3D3D3;
  display: flex;
  flex-direction: column;
  gap: 40px;
  max-width: 800px;
  margin: 0 auto;
}

.miembro {
  display: flex;
  align-items: center;
  gap: 20px;
}

.miembro:nth-child(odd) {
  flex-direction: row-reverse;
}

.descripcion {
  max-width: 58%;
  font-size: 14px;
  color: var(--color-gris-texto);
}

.descripcion strong {
  color: var(--color-verde);
}

.nombre {
  font-size: 1.25rem;
  color: var(--color-verde);
  margin: 0 0 0.5rem;
}

.perfil {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  object-fit: cover;
  border: 3px solid var(--color-gris-claro);
  display: block;
}

.perfil-container {
  position: relative;
  width: 120px;
  height: 120px;
  flex-shrink: 0;
}

.perfil-link {
  display: block;
  width: 120px;
  height: 120px;
  border-radius: 50%;
  position: relative;
}

.perfil-link::before {
  content: "";
  position: absolute;
  inset: 0;
  background-color: rgba(46, 125, 50, 0.85);
  border-radius: 50%;
  opacity: 0;
  transition: opacity 0.3s ease-in-out;
}

.linkedin-icon {
  position: absolute;
  inset: 0;
  width: 32px;
  height: 32px;
  margin: auto;
  fill: var(--color-blanco);
  opacity: 0;
  transition: opacity 0.3s ease-in-out;
  pointer-events: none;
}

.perfil-link:hover::before,
.perfil-link:focus-visible::before,
.perfil-link:hover .linkedin-icon,
.perfil-link:focus-visible .linkedin-icon {
  opacity: 1;
}

@media (max-width: 768px) {
  .miembro {
    flex-direction: column;
    text-align: center;
  }

  .miembro:nth-child(odd) {
    flex-direction: column;
  }

  .descripcion {
    max-width: 100%;
  }
}
</style>



<div class="equipo-container">
  {equipo.map((persona) => (
    <div class="miembro">
      <div class="perfil-container">
        <a class="perfil-link" href={persona.linkedin} target="_blank" aria-label={`LinkedIn de ${persona.nombre}`}>
          <img class="perfil" src={persona.imagen} alt={persona.nombre} loading="lazy" />
          <svg class="linkedin-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M19 0h-14c-2.76 0-5 2.24-5 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5v-14c0-2.76-2.24-5-5-5zm-11 19h-3v-10h3v10zm-1.5-11.5c-1 0-1.5-.7-1.5-1.5s.5-1.5 1.5-1.5 1.5.7 1.5 1.5-.5 1.5-1.5 1.5zm13.5 11.5h-3v-5.5c0-1.5-.5-2.5-1.8-2.5-1 0-1.6.7-1.9 1.4-.1.3-.1.7-.1 1.1v5.5h-3v-10h2.9v1.4c.4-.7 1.3-1.7 3.2-1.7 2.3 0 4.1 1.5 4.1 4.7v5.6z"/>
          </svg>
        </a>
      </div>
      <div class="descripcion">
        <p class="nombre"><strong>{persona.nombre}</strong></p>
        <p class="subtitulo">{persona.descripcion}</p>
      </div>
    </div>
  ))}
</div>
