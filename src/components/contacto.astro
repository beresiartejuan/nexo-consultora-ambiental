<div class="formulario" id="formulario">
    <h1 class="titulo">CONTACTATE CON NOSOTROS</h1>
        <form action="https://formspree.io/f/meoevywb" method="POST">
            <div class="form-group">
                <label for="nombre">Nombre:</label>
                <input type="text" id="nombre" name="nombre" placeholder="Ej: María González" required aria-required="true">
            </div>

            <div class="form-group">
                <label for="email">Correo Electrónico:</label>
                <input type="email" id="email" name="email" placeholder="Ej: maria@correo.com" required aria-required="true">
            </div>

            <div class="form-group">
                <label for="mensaje">Mensaje:</label>
                <textarea id="mensaje" name="mensaje" placeholder="Escribí tu consulta..." required aria-required="true"></textarea>
            </div>

            <button type="submit" class="btn-submit">Enviar</button>
        </form>

</div>

<style>
    .formulario {
        background-color: var(--color-blanco);
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        max-width: 600px;
        margin: 0 auto;
    }

    .formulario form {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .form-group {
    margin-bottom: 15px;
    }

    label {
    display: block;
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 5px;
    color: var(--color-verde);
    }

    input, textarea {
        width: 100%;
        max-width: 100%;
        padding: 10px;
        border: 1px solid var(--color-tierra);
        border-radius: 5px;
        font-size: 14px;
        box-sizing: border-box; /* Asegura que padding no afecte el ancho total */
        display: block; /* Asegura que no se desborden */
    }

    textarea {
    resize: vertical;
    }

    input:focus, textarea:focus {
    border: 2px solid var(--color-azul); /* Borde azul visible en foco */
    outline: none;
    }

    .btn-submit {
    background-color: var(--color-verde); /* Color primario */
    color: var(--color-blanco);
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    font-size: 16px;
    cursor: pointer;
    transition: background-color 0.3s ease;
    align-self: center;
    }

    .btn-submit:hover {
    background-color: var(--color-azul);
    }
</style>
