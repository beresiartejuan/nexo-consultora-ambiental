---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import Footer from '../components/footer.astro';
import Banner from '../components/banner.astro';
import Equipo from '../components/equipo.astro';
import Contacto from '../components/contacto.astro';
import Navigation from '../components/navigation.astro';
import Servicios from '../components/servicios.astro';
---

<Layout>
    <Navigation />

    <header>
        <Banner />
    </header>

    <main>
        <section id="nosotros" class="section section-alt">
            <div class="container">
                <h2 class="titulo">Acerca de <span>Nosotros</span></h2>
                <p class="subtitulo">
                    Nexo ambiental es un grupo interdisciplinario que surge de las necesidades de diferentes
                    sectores productivos, entes públicos y privados en materia ambiental.
                </p>
                <div class="about-grid">
                    <div class="about-card">
                        <span class="about-icon" aria-hidden="true">🌿</span>
                        <h2>¿Quiénes somos?</h2>
                        <p>
                            Somos el <em>nexo</em> entre la legislación, el desarrollo sustentable y productivo, y lo que conlleva al
                            cuidado del medio ambiente.
                        </p>
                    </div>
                    <div class="about-card mission">
                        <span class="about-icon" aria-hidden="true">🎯</span>
                        <h2>Nuestra misión</h2>
                        <p>
                            Proporcionar servicios de calidad, con personal altamente capacitado,
                            interpretando las necesidades y ayudando a resolverlas de manera eficiente y rápida.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <div class="parallax" aria-hidden="true"></div>

        <section id="servicios" class="section">
            <div class="container">
                <h2 class="titulo">Nuestros <span>Servicios</span></h2>
                <p class="subtitulo">
                    Proporcionamos soluciones ambientales, estratégicas y orientación legal ambiental mediante
                    soporte y asesoramiento de calidad para ayudar a concretar los proyectos de nuestros clientes.
                    Además, somos el nexo entre el cliente y las autoridades de aplicación.
                </p>
                <p class="subtitulo"><strong>Nuestro compromiso es:</strong></p>
                <ul class="lista-valores">
                    <li>Generar conciencia y conductas ambientales, haciendo hincapié en las normativas
                    vigentes, brindando capacitaciones en el sector educativo y municipal.</li>
                    <li>Garantizar que los procesos productivos sean eficientes y estén en armonía con el
                    ambiente.</li>
                </ul>
                <Servicios />
            </div>
        </section>

        <section id="equipo" class="section section-alt">
            <div class="container">
                <h2 class="titulo">Nuestro <span>Equipo</span></h2>
                <p class="subtitulo">
                    Contamos con un equipo multidisciplinario, especializado en diferentes áreas,
                    tales como ingeniería ambiental, hidrogeología, edafología, fauna, flora, seguridad e higiene, entre otros;
                    con capacidad y experiencia en servicios de distintas características.
                </p>
                <Equipo />
            </div>
        </section>

        <div class="parallax" aria-hidden="true"></div>

        <section id="contacto" class="section">
            <div class="container">
                <h2 class="titulo">Contactate con <span>Nosotros</span></h2>
                <Contacto />
            </div>
        </section>
    </main>

    <Footer />
</Layout>

<style>
    .about-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
        max-width: 900px;
        margin: 2.5rem auto 0;
    }

    .about-card {
        background-color: var(--color-blanco);
        border-radius: var(--radio);
        padding: 2rem;
        box-shadow: var(--sombra);
        text-align: center;
        transition: transform var(--transicion), box-shadow var(--transicion);
    }

    .about-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--sombra-hover);
    }

    .about-card.mission {
        border-top: 4px solid var(--color-azul);
    }

    .about-card:not(.mission) {
        border-top: 4px solid var(--color-verde);
    }

    .about-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background-color: var(--color-verde-claro);
        font-size: 1.75rem;
        margin-bottom: 1rem;
    }

    .about-card h2 {
        font-family: 'Poppins', sans-serif;
        font-size: 1.25rem;
        color: var(--color-verde-oscuro);
        margin: 0 0 0.75rem;
    }

    .about-card p {
        color: var(--color-gris-medio);
        margin: 0;
    }

    @media (max-width: 768px) {
        .about-grid {
            grid-template-columns: 1fr;
            gap: 1.25rem;
            margin-top: 1.75rem;
        }

        .about-card {
            padding: 1.5rem;
        }
    }
</style>
