---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import Footer from '../components/footer.astro';
import Banner from '../components/banner.astro';
import Equipo from '../components/equipo.astro';
import Contacto from '../components/contacto.astro';
import Navigation from '../components/navigation.astro';
import Servicios from '../components/servicios.astro';
---

<Layout title="Nexo Consultora Ambiental">
    <header>
        <section id="inicio">
            <Navigation />
            <hr>
            <Banner />
        </section>
    </header>

    <main>
        <div class="parallax"></div>

        <section id="nosotros">
            <h1 class="titulo">Acerca de Nosotros</h1>
            <p class="subtitulo">
                Nexo ambiental es un grupo interdisciplinario, que surge de las necesidades de diferentes
                sectores productivos, entes públicos y privados en materia ambiental. <br>
                Somos el <em>nexo</em> entre la legislación, el desarrollo sustentable y productivo, y lo que conlleva al
                cuidado del medio ambiente. <br>
                Nuestra <b>misión</b> es proporcionar servicios de calidad, con personal altamente capacitado
                interpretando las necesidades y ayudando a resolverlas de manera eficiente y rápida.
            </p>
        </section>

        <div class="parallax"></div>

        <section id="servicios">
            <h1 class="titulo">Servicios</h1>
            <p class="subtitulo">
                Proporcionamos soluciones ambientales, estratégicas y orientación legal ambiental mediante
                soporte y asesoramiento de calidad para ayudar a concretar los proyectos de nuestros clientes.
                Además, somos el nexo entre el cliente y las autoridades de aplicación.
            </p>
            <p class="subtitulo"><b>Nuestro compromiso es:</b></p>
            <ul class="lista-valores">
                <li>Generar conciencia y conductas ambientales, haciendo hincapié en las normativas
                vigentes, brindando capacitaciones en el sector educativo y municipal.</li>
                <li>Garantizar que los procesos productivos sean eficientes y estén en armonía con el
                ambiente.</li>
            </ul>
            <Servicios />
        </section>

        <div class="parallax"></div>

        <section id="equipo">
            <h1 class="titulo">NUESTRO EQUIPO</h1>
            <p class="subtitulo">
                Contamos con un equipo multidisciplinario, especializado en diferentes áreas, <br>
                tales como ingeniería ambiental, hidrogeología, edafología, fauna, flora, seguridad e higiene, entre otros;<br>
                con capacidad y experiencia en servicios de distintas características.
            </p>
            <Equipo />
        </section>

        <div class="parallax"></div>

        <section id="contacto">
            <Contacto />
        </section>
    </main>

    <Footer />
</Layout>
